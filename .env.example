# Example environment variables
# Set your public WhatsApp number without + or leading zeros, e.g. 62812....
NEXT_PUBLIC_WHATSAPP=6281200000000

# Analytics / third-party keys
# NEXT_PUBLIC_ANALYTICS_ID=

# Search Console / Bing (optional). Paste the verification token only, not the full meta tag.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Password untuk halaman admin tersembunyi: /psks-ops
ADMIN_PASSWORD=ganti-password-anda

# Link toko marketplace untuk /belanja-kuesubuh
NEXT_PUBLIC_WEBSITE_URL=https://www.pasarsenenkuesubuh.com/
NEXT_PUBLIC_SHOPEE_URL=https://shopee.co.id/.goodvibes.
NEXT_PUBLIC_TOKOPEDIA_URL=https://tokopedia.link/snackboz
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/6281806791309

# Turso (libSQL) — jangan commit token asli
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# Add other secrets to .env (do NOT commit real secrets)
